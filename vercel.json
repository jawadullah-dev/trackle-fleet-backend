{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/gps-sync",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "src/**,prisma/**"
    }
  },
  "routes": [
     {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
